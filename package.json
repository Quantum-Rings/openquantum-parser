  },
  "homepage": "https://github.com/comp-phys-marc/qasm-ts#readme",
  "dependencies": {
    "path": "^0.12.7",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.15",
    "@types/node": "^24.12.4",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "jasmine": "^5.13.0",
    "nyc": "^18.0.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3"
  }
